{
  "name": "opencode-ts-typecheck",
  "version": "0.1.1",
  "description": "Automatic TypeScript checking and agent repair for OpenCode",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gerkirill/opencode-ts-typecheck.git"
  },
  "homepage": "https://github.com/gerkirill/opencode-ts-typecheck#readme",
  "bugs": { "url": "https://github.com/gerkirill/opencode-ts-typecheck/issues" },
  "keywords": ["opencode", "opencode-plugin", "typescript", "typecheck"],
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "type": "module",
  "exports": { ".": "./src/index.ts" },
  "files": ["src", "README.md", "LICENSE"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "npm run check"
  },
  "engines": { "node": ">=22" },
  "peerDependencies": {
    "@opencode/plugin": "~2.4.1",
    "effect": "~4.1.0"
  },
  "devDependencies": {
    "@opencode/plugin": "2.4.1",
    "@types/node": "^24.0.0",
    "effect": "4.1.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
