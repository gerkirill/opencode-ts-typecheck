{
  "name": "opencode-typecheck",
  "version": "0.1.0",
  "description": "A typecheck completion gate for OpenCode V2",
  "type": "module",
  "exports": { ".": "./src/index.ts" },
  "files": ["src", "README.md"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "engines": { "node": ">=22" },
  "peerDependencies": {
    "@opencode/plugin": "~2.4.1",
    "effect": "~4.1.0"
  },
  "devDependencies": {
    "@opencode/plugin": "2.4.1",
    "@types/node": "^24.0.0",
    "effect": "4.1.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
